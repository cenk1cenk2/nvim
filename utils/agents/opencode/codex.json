{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "enabled_providers": ["openai"],
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "edit": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git rev-parse": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "ls": "allow",
      "wc": "allow",
      "stat": "allow",
      "which": "allow",
      "file": "allow",
      "pwd": "allow",
      "type": "allow"
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "allow"
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.3-codex-spark": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  }
}
