{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilic/glm-5:cloud",
  "enabled_providers": ["kilic"],
  "provider": {
    "kilic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "kilic",
      "options": {
        "baseURL": "https://ai.kilic.dev/ollama/v1",
        "apiKey": "{env:AI_KILIC_DEV_API_KEY}"
      },
      "models": {
        "glm-5:cloud": {
          "name": "GLM-5 Cloud"
        },
        "kimi-k2.5:cloud": {
          "name": "Kimi K2.5 Cloud"
        },
        "minimax-m2.7:cloud": {
          "name": "Minimax M2.7 Cloud"
        },
        "gemma4:31b-cloud": {
          "name": "Gemma4 Cloud"
        }
      }
    }
  }
}
