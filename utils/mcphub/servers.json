{
  "mcpServers": {
    "cclsp": {
      "args": [
        "-y",
        "cclsp@latest"
      ],
      "autoApprove": [
        "find_definition",
        "find_references",
        "get_diagnostics"
      ],
      "command": "bunx",
      "disabled": false,
      "env": {
        "CCLSP_CONFIG_PATH": "${HOME}/.config/nvim/utils/claude/cclsp.json"
      }
    },
    "context7": {
      "autoApprove": [
        "get-library-docs",
        "resolve-library-id",
        "query-docs"
      ],
      "headers": {
        "CONTEXT7_API_KEY": "${NVIM_CONTEXT7}"
      },
      "url": "https://mcp.context7.com/mcp"
    },
    "fetch": {
      "args": [
        "mcp-server-fetch@latest"
      ],
      "autoApprove": [
        "fetch"
      ],
      "command": "uvx",
      "disabled": true
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "${CWD}"
      ],
      "autoApprove": [
        "directory_tree",
        "get_file_info",
        "list_allowed_directories",
        "list_directory",
        "list_directory_with_sizes",
        "search_files",
        "read_file",
        "read_media_file",
        "read_multiple_files",
        "read_text_file"
      ],
      "command": "bunx",
      "disabled_tools": [
        "write_file",
        "edit_file",
        "list_directory_with_sizes"
      ]
    },
    "git": {
      "args": [
        "mcp-server-git@latest"
      ],
      "autoApprove": [
        "git_diff",
        "git_diff_staged",
        "git_diff_unstaged",
        "git_log",
        "git_show",
        "git_status"
      ],
      "command": "uvx",
      "disabled_tools": [
        "git_add",
        "git_branch",
        "git_checkout",
        "git_commit",
        "git_create_branch",
        "git_reset"
      ]
    },
    "github": {
      "autoApprove": [
        "get_me",
        "issue_read",
        "list_pull_requests",
        "list_issues",
        "list_issue_types",
        "list_releases",
        "list_tags",
        "search_code",
        "search_issues",
        "search_pull_requests",
        "search_repositories",
        "search_users",
        "list_commits",
        "list_branches",
        "get_teams",
        "get_team_members",
        "get_tag",
        "get_release_by_tag",
        "get_latest_release",
        "get_label",
        "get_file_contents",
        "get_commit",
        "pull_request_read",
        "request_copilot_review"
      ],
      "disabled": false,
      "disabled_tools": [
        "assign_copilot_to_issue",
        "create_branch",
        "create_or_update_file",
        "create_repository",
        "delete_file",
        "fork_repository",
        "get_label",
        "get_team_members",
        "merge_pull_request"
      ],
      "headers": {
        "Authorization": "Bearer ${NVIM_GITHUB}",
        "X-MCP-Insiders": "true"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gitlab": {
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "autoApprove": [
        "get_branch_diffs",
        "get_commit",
        "get_commit_diff",
        "get_file_contents",
        "get_issue",
        "get_issue_link",
        "get_label",
        "get_merge_request",
        "get_merge_request_approval_state",
        "get_merge_request_diffs",
        "get_merge_request_version",
        "get_namespace",
        "get_project",
        "get_project_events",
        "get_release",
        "get_repository_tree",
        "get_users",
        "list_commits",
        "list_events",
        "list_group_iterations",
        "list_group_projects",
        "list_issue_discussions",
        "list_issue_links",
        "list_issues",
        "list_labels",
        "list_merge_request_versions",
        "list_merge_requests",
        "list_namespaces",
        "list_project_members",
        "list_projects",
        "list_releases",
        "my_issues",
        "search_repositories",
        "verify_namespace",
        "mr_discussions"
      ],
      "command": "npx",
      "disabled_tools": [
        "download_attachment",
        "download_release_asset"
      ],
      "env": {
        "GITLAB_API_URL": "https://gitlab.kilic.dev/api/v4/",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${NVIM_GITLAB}",
        "GITLAB_READ_ONLY_MODE": "true"
      }
    },
    "kubernetes": {
      "args": [
        "-y",
        "kubernetes-mcp-server@latest",
        "--read-only"
      ],
      "autoApprove": [
        "get_pod",
        "list_pods",
        "get_pod_logs",
        "list_namespaces",
        "get_resource",
        "list_resources"
      ],
      "command": "bunx",
      "disabled": true
    },
    "linear/kilic-dev": {
      "autoApprove": [
        "list_issues",
        "list_projects",
        "list_project_labels",
        "list_teams",
        "list_users",
        "search_documentation",
        "list_issue_statuses",
        "list_issue_labels",
        "list_documents",
        "list_cycles",
        "list_comments",
        "get_user",
        "get_team",
        "get_project",
        "get_issue_status",
        "get_issue",
        "get_document",
        "get_attachment",
        "extract_images",
        "get_initiative",
        "get_milestone",
        "get_status_updates",
        "list_initiatives",
        "list_milestones"
      ],
      "env": {
        "LINEAR_TOKEN": "${NVIM_LINEAR_KILIC}"
      },
      "headers": {
        "Authorization": "Bearer ${NVIM_LINEAR_KILIC}"
      },
      "url": "https://mcp.linear.app/sse"
    },
    "linear/laravel": {
      "autoApprove": [
        "get_attachment",
        "get_document",
        "get_initiative",
        "get_issue",
        "get_issue_status",
        "get_milestone",
        "get_project",
        "get_status_updates",
        "get_team",
        "get_user",
        "list_comments",
        "list_cycles",
        "list_documents",
        "list_initiatives",
        "list_issue_labels",
        "list_issue_statuses",
        "list_issues",
        "list_milestones",
        "list_project_labels",
        "list_projects",
        "list_teams",
        "list_users",
        "search_documentation",
        "extract_images"
      ],
      "env": {
        "LINEAR_TOKEN": "${NVIM_LINEAR_WORK}"
      },
      "headers": {
        "Authorization": "Bearer ${NVIM_LINEAR_WORK}"
      },
      "url": "https://mcp.linear.app/mcp"
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@latest"
      ],
      "autoApprove": [
        "create_relations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "open_nodes",
        "read_graph",
        "search_nodes",
        "add_observations",
        "create_entities"
      ],
      "command": "bunx",
      "env": {
        "MEMORY_FILE_PATH": "${HOME}/.local/state/nvim/memory.jsonl"
      }
    },
    "nvim": {
      "args": [
        "-y",
        "mcp-neovim-server@latest"
      ],
      "autoApprove": [
        "vim_buffer",
        "vim_buffer_switch",
        "vim_file_open",
        "vim_fold",
        "vim_grep",
        "vim_jump",
        "vim_search",
        "vim_status"
      ],
      "command": "bunx",
      "disabled": true,
      "env": {
        "ALLOW_SHELL_COMMANDS": "true",
        "NVIM_SOCKET_PATH": "${NVIM}"
      }
    },
    "obsidian": {
      "args": [
        "-y",
        "obsidian-mcp-server@latest"
      ],
      "autoApprove": [
        "obsidian_global_search",
        "obsidian_list_notes",
        "obsidian_read_note"
      ],
      "command": "bunx",
      "env": {
        "OBSIDIAN_API_KEY": "${NVIM_OBSIDIAN}",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
        "OBSIDIAN_ENABLE_CACHE": "true",
        "OBSIDIAN_VERIFY_SSL": "false"
      }
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@latest"
      ],
      "autoApprove": [
        "sequentialthinking"
      ],
      "command": "bunx",
      "disabled": false
    },
    "tmux": {
      "args": [
        "-y",
        "tmux-mcp",
        "--shell-type=zsh"
      ],
      "autoApprove": [
        "get-command-result",
        "list-panes",
        "list-sessions",
        "list-windows"
      ],
      "command": "bunx",
      "disabled_tools": [
        "kill-window",
        "kill-session",
        "kill-pane",
        "create-session"
      ]
    },
    "treesitter": {
      "args": [
        "mcp-server-tree-sitter@latest"
      ],
      "autoApprove": [
        "check_language_available",
        "configure",
        "find_similar_code",
        "find_text",
        "find_usage",
        "get_ast",
        "get_dependencies",
        "get_file",
        "get_file_metadata",
        "get_node_at_position",
        "get_node_types",
        "get_query_template_tool",
        "get_symbols",
        "list_files",
        "list_languages",
        "list_projects_tool",
        "list_query_templates_tool",
        "run_query"
      ],
      "command": "uvx",
      "disabled_tools": [
        "analyze_complexity",
        "analyze_project",
        "adapt_query",
        "build_query",
        "clear_cache",
        "diagnose_config",
        "register_project_tool",
        "remove_project_tool"
      ]
    },
    "vectorcode": {
      "args": [],
      "command": "vectorcode-mcp-server",
      "disabled": true
    }
  },
  "nativeMCPServers": {
    "browser": {
      "autoApprove": [
        "open_in_browser",
        "open_in_obsidian"
      ],
      "disabled_tools": []
    },
    "mcphub": {
      "autoApprove": [
        "get_current_servers"
      ]
    },
    "neovim": {
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "read_multiple_files"
      ],
      "disabled": false,
      "disabled_tools": []
    }
  }
}
