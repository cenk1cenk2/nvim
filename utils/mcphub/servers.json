{
  "mcpServers": {
    "github": {
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gitlab": {
      "args": [
        "mcp-server-gitlab"
      ],
      "command": "uvx",
      "disabled": true,
      "env": {
        "GITLAB_API_URL": "https://${GL_HOST}/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GL_TOKEN}"
      }
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "autoApprove": [
        "sequentialthinking"
      ],
      "command": "bunx"
    }
  },
  "nativeMCPServers": {
    "mcphub": {
      "autoApprove": [
        "get_current_servers"
      ]
    },
    "neovim": {
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "read_multiple_files"
      ],
      "disabled": false
    }
  }
}
