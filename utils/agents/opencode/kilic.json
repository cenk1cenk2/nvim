{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilic/minimax-m2.7:cloud",
  "enabled_providers": ["kilic"],
  "autoupdate": false,
  "permission": {
    "*": "ask",
    "edit": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git rev-parse": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "ls": "allow",
      "wc": "allow",
      "stat": "allow",
      "which": "allow",
      "file": "allow",
      "pwd": "allow",
      "type": "allow"
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "allow"
  },
  "provider": {
    "kilic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "kilic",
      "options": {
        "baseURL": "https://ai.kilic.dev/ollama/v1",
        "apiKey": "{env:AI_KILIC_DEV_API_KEY}"
      },
      "models": {
        "glm-5.1:cloud": {
          "name": "GLM-5.1 Cloud"
        },
        "kimi-k2.5:cloud": {
          "name": "Kimi K2.5 Cloud"
        },
        "minimax-m2.7:cloud": {
          "name": "Minimax M2.7 Cloud"
        },
        "gemma4:31b-cloud": {
          "name": "Gemma4 Cloud"
        },
        "gemma4:e2b": {
          "name": "Gemma4 e2b"
        }
      }
    }
  }
}
