{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode", "opencode-go"],
  "autoupdate": false,
  "permission": {
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git rev-parse": "allow",
      "git remote -v": "allow",
      "git tag": "allow",
      "ls": "allow",
      "wc": "allow",
      "stat": "allow",
      "which": "allow",
      "file": "allow",
      "pwd": "allow",
      "type": "allow"
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": "allow"
  }
}
