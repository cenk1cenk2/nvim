{
  "mcpServers": {
    "decision": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}"
      },
      "url": "https://decision.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": ["decide"],
        "autoRejectTools": []
      }
    },
    "excalidraw": {
      "url": "https://mcp.excalidraw.com",
      "hyprpilot": {
        "autoAcceptTools": ["read_me", "create_view", "export_to_excalidraw", "save_checkpoint", "read_checkpoint"],
        "autoRejectTools": []
      }
    },
    "github": {
      "headers": {
        "Authorization": "Bearer ${NVIM_GITHUB}",
        "X-MCP-Insiders": "true"
      },
      "url": "https://api.githubcopilot.com/mcp/",
      "hyprpilot": {
        "excludeTools": [
          "assign_copilot_to_issue",
          "create_branch",
          "create_or_update_file",
          "create_repository",
          "delete_file",
          "fork_repository",
          "get_label",
          "get_team_members",
          "merge_pull_request"
        ],
        "autoAcceptTools": [
          "get_me",
          "issue_read",
          "list_pull_requests",
          "list_issues",
          "list_issue_types",
          "list_releases",
          "list_tags",
          "search_code",
          "search_issues",
          "search_pull_requests",
          "search_repositories",
          "search_users",
          "list_commits",
          "list_branches",
          "get_teams",
          "get_team_members",
          "get_tag",
          "get_release_by_tag",
          "get_latest_release",
          "get_label",
          "get_file_contents",
          "get_commit",
          "pull_request_read",
          "request_copilot_review"
        ],
        "autoRejectTools": []
      }
    },
    "gitlab": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}",
        "x-gitlab-token": "${NVIM_GITLAB}"
      },
      "url": "https://gitlab.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": [
          "get_branch",
          "get_branch_diffs",
          "get_ci_catalog_resource",
          "get_commit",
          "get_commit_diff",
          "get_deployment",
          "get_draft_note",
          "get_environment",
          "get_file_blame",
          "get_file_contents",
          "get_issue",
          "get_issue_link",
          "get_label",
          "get_merge_request",
          "get_merge_request_approval_state",
          "get_merge_request_conflicts",
          "get_merge_request_diffs",
          "get_merge_request_file_diff",
          "get_merge_request_note",
          "get_merge_request_notes",
          "get_merge_request_version",
          "get_namespace",
          "get_pipeline",
          "get_pipeline_job",
          "get_pipeline_job_output",
          "get_project",
          "get_project_events",
          "get_protected_branch",
          "get_repository_tree",
          "get_user",
          "get_users",
          "health_check",
          "list_branches",
          "list_ci_catalog_resources",
          "list_commit_statuses",
          "list_commits",
          "list_deployments",
          "list_draft_notes",
          "list_environments",
          "list_events",
          "list_group_iterations",
          "list_group_members",
          "list_group_projects",
          "list_issue_discussions",
          "list_issue_emoji_reactions",
          "list_issue_links",
          "list_issue_note_emoji_reactions",
          "list_issues",
          "list_labels",
          "list_merge_request_changed_files",
          "list_merge_request_diffs",
          "list_merge_request_emoji_reactions",
          "list_merge_request_note_emoji_reactions",
          "list_merge_request_pipelines",
          "list_merge_request_versions",
          "list_merge_requests",
          "list_namespaces",
          "list_pipeline_jobs",
          "list_pipeline_trigger_jobs",
          "list_pipelines",
          "list_project_members",
          "list_projects",
          "list_protected_branches",
          "list_todos",
          "mr_discussions",
          "my_issues",
          "search_repositories",
          "verify_namespace",
          "whoami"
        ],
        "autoRejectTools": []
      }
    },
    "obsidian": {
      "url": "http://127.0.0.1:27123/mcp/",
      "headers": {
        "Authorization": "Bearer ${NVIM_OBSIDIAN}"
      },
      "hyprpilot": {
        "autoAcceptTools": [
          "active_file_get_path",
          "command_list",
          "open_file",
          "search_query",
          "search_simple",
          "tag_list",
          "vault_get_document_map",
          "vault_list",
          "vault_read"
        ],
        "autoRejectTools": []
      }
    },
    "research": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}"
      },
      "url": "https://research.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": [
          "exa_web_search_exa",
          "exa_web_fetch_exa",
          "tavily_tavily_search",
          "tavily_tavily_extract",
          "tavily_tavily_crawl",
          "tavily_tavily_map",
          "tavily_tavily_research",
          "context7_resolve-library-id",
          "context7_query-docs"
        ],
        "autoRejectTools": []
      }
    },
    "tmux": {
      "args": ["-y", "--bun", "tmux-mcp", "--shell-type=zsh"],
      "command": "bunx",
      "hyprpilot": {
        "excludeTools": ["create-session", "create-window", "execute-command", "kill-pane", "kill-session", "kill-window", "split-pane"],
        "autoAcceptTools": ["get-command-result", "list-panes", "list-sessions", "list-windows", "capture-pane", "find-session"],
        "autoRejectTools": []
      }
    }
  }
}
