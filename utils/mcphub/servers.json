{
  "mcpServers": {
    "cclsp": {
      "args": ["-y", "cclsp"],
      "autoApprove": ["find_definition", "find_references", "get_diagnostics"],
      "command": "bunx",
      "disabled": false,
      "env": {
        "CCLSP_CONFIG_PATH": "${HOME}/.config/nvim/utils/claude/cclsp.json"
      }
    },
    "context7": {
      "args": ["-y", "@upstash/context7-mcp"],
      "autoApprove": ["get-library-docs", "resolve-library-id", "query-docs"],
      "command": "bunx",
      "env": [],
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "fetch": {
      "args": ["mcp-server-fetch"],
      "autoApprove": ["fetch"],
      "command": "uvx"
    },
    "filesystem": {
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${CWD}"],
      "autoApprove": [
        "directory_tree",
        "get_file_info",
        "list_allowed_directories",
        "list_directory",
        "list_directory_with_sizes",
        "search_files",
        "read_file",
        "read_media_file",
        "read_multiple_files",
        "read_text_file"
      ],
      "command": "bunx",
      "disabled_tools": ["write_file"]
    },
    "git": {
      "args": ["mcp-server-git"],
      "autoApprove": ["git_diff", "git_diff_staged", "git_diff_unstaged", "git_log", "git_show", "git_status"],
      "command": "uvx"
    },
    "github": {
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gitlab": {
      "args": ["-y", "@zereight/mcp-gitlab"],
      "command": "npx",
      "env": {
        "GITLAB_API_URL": "https://gitlab.kilic.dev/api/v4/",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GL_TOKEN}",
        "GITLAB_READ_ONLY_MODE": "true"
      }
    },
    "linear": {
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse", "--header", "Authorization: Bearer ${LINEAR_TOKEN}"],
      "autoApprove": [
        "list_issues",
        "list_projects",
        "list_project_labels",
        "list_teams",
        "list_users",
        "search_documentation",
        "list_issue_statuses",
        "list_issue_labels",
        "list_documents",
        "list_cycles",
        "list_comments",
        "get_user",
        "get_team",
        "get_project",
        "get_issue_status",
        "get_issue",
        "get_document"
      ],
      "command": "bunx",
      "headers": {
        "LINEAR_TOKEN": "${LINEAR_TOKEN}"
      }
    },
    "linear-work": {
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/sse", "--header", "Authorization: Bearer ${LINEAR_TOKEN}"],
      "autoApprove": [],
      "command": "bunx",
      "headers": {
        "LINEAR_TOKEN": "${LINEAR_WORK_TOKEN}"
      }
    },
    "memory": {
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "autoApprove": [
        "create_relations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "open_nodes",
        "read_graph",
        "search_nodes",
        "add_observations",
        "create_entities"
      ],
      "command": "bunx"
    },
    "nvim": {
      "args": ["-y", "mcp-neovim-server"],
      "autoApprove": ["vim_buffer", "vim_buffer_switch", "vim_file_open", "vim_fold", "vim_grep", "vim_jump", "vim_search", "vim_status"],
      "command": "bunx",
      "disabled": false,
      "env": {
        "ALLOW_SHELL_COMMANDS": "true",
        "NVIM_SOCKET_PATH": "${NVIM}"
      }
    },
    "obsidian": {
      "args": ["obsidian-mcp-server"],
      "autoApprove": ["obsidian_global_search", "obsidian_list_notes", "obsidian_read_note"],
      "command": "bunx",
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
        "OBSIDIAN_ENABLE_CACHE": "true",
        "OBSIDIAN_VERIFY_SSL": "false"
      }
    },
    "sequentialthinking": {
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "autoApprove": ["sequentialthinking"],
      "command": "bunx",
      "disabled": false
    },
    "treesitter": {
      "args": ["mcp-server-tree-sitter"],
      "autoApprove": [
        "check_language_available",
        "configure",
        "find_similar_code",
        "find_text",
        "find_usage",
        "get_ast",
        "get_dependencies",
        "get_file",
        "get_file_metadata",
        "get_node_at_position",
        "get_node_types",
        "get_query_template_tool",
        "get_symbols",
        "list_files",
        "list_languages",
        "list_projects_tool",
        "list_query_templates_tool",
        "run_query"
      ],
      "command": "uvx"
    },
    "vectorcode": {
      "args": [],
      "command": "vectorcode-mcp-server"
    }
  },
  "nativeMCPServers": {
    "browser": {
      "autoApprove": ["open_in_browser", "open_in_obsidian"],
      "disabled_tools": []
    },
    "mcphub": {
      "autoApprove": ["get_current_servers"]
    },
    "neovim": {
      "autoApprove": ["find_files", "list_directory", "read_file", "read_multiple_files"],
      "disabled": false,
      "disabled_tools": []
    }
  }
}
