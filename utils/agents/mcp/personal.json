{
  "mcpServers": {
    "argocd-kilic": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}",
        "x-argocd-token": "${NVIM_ARGOCD_KILIC_TOKEN}"
      },
      "url": "https://argocd.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": [
          "get_application",
          "get_application_events",
          "get_application_managed_resources",
          "get_application_resource_tree",
          "get_application_workload_logs",
          "get_appproject",
          "get_resource_actions",
          "get_resource_events",
          "get_resources",
          "list_applications",
          "list_clusters"
        ],
        "autoRejectTools": []
      }
    },
    "grafana-kilic": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}",
        "x-grafana-token": "${NVIM_GRAFANA_KILIC_TOKEN}"
      },
      "url": "https://grafana.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": [
          "analyze_loki_labels",
          "check_datasources_health",
          "find_error_pattern_logs",
          "find_slow_requests",
          "generate_deeplink",
          "get_alert_group",
          "get_annotation_tags",
          "get_annotations",
          "get_assertions",
          "get_dashboard_by_uid",
          "get_dashboard_panel_queries",
          "get_dashboard_property",
          "get_dashboard_summary",
          "get_datasource",
          "get_plugin",
          "get_snapshot",
          "list_alert_groups",
          "list_datasources",
          "list_loki_label_names",
          "list_loki_label_values",
          "list_prometheus_label_names",
          "list_prometheus_label_values",
          "list_prometheus_metric_metadata",
          "list_prometheus_metric_names",
          "list_provisioning_repositories",
          "list_snapshots",
          "query_loki_logs",
          "query_loki_patterns",
          "query_loki_stats",
          "query_prometheus",
          "query_prometheus_histogram",
          "query_pyroscope",
          "search_dashboards",
          "search_folders",
          "search_plugin_information",
          "suggest_loki_alloy_label_config"
        ],
        "autoRejectTools": []
      }
    },
    "kubernetes-kilic": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}",
        "x-kubernetes-token": "${NVIM_KUBERNETES_TOKEN}"
      },
      "url": "https://kubernetes.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": ["*"],
        "autoRejectTools": []
      }
    },
    "linear-kilic": {
      "headers": {
        "Authorization": "Bearer ${NVIM_LINEAR_KILIC}"
      },
      "url": "https://mcp.linear.app/mcp",
      "hyprpilot": {
        "autoAcceptTools": [
          "extract_images",
          "get_attachment",
          "get_authenticated_user",
          "get_document",
          "get_initiative",
          "get_issue",
          "get_issue_status",
          "get_milestone",
          "get_project",
          "get_status_updates",
          "get_team",
          "get_user",
          "list_comments",
          "list_customers",
          "list_cycles",
          "list_documents",
          "list_initiatives",
          "list_issue_labels",
          "list_issue_statuses",
          "list_issues",
          "list_milestones",
          "list_project_labels",
          "list_projects",
          "list_teams",
          "list_users",
          "research",
          "search_documentation"
        ],
        "autoRejectTools": []
      }
    },
    "playwright": {
      "args": ["-y", "--bun", "@playwright/mcp@latest", "--executable-path", "/usr/bin/brave"],
      "command": "bunx",
      "hyprpilot": {
        "autoAcceptTools": [
          "browser_take_screenshot",
          "browser_snapshot",
          "browser_navigate",
          "browser_navigate_back",
          "browser_resize",
          "browser_run_code",
          "browser_wait_for",
          "browser_type",
          "browser_tabs",
          "browser_select_option",
          "browser_press_key",
          "browser_network_requests",
          "browser_hover",
          "browser_handle_dialog",
          "browser_fill_form",
          "browser_file_upload",
          "browser_evaluate",
          "browser_drag",
          "browser_console_messages",
          "browser_close",
          "browser_click"
        ],
        "autoRejectTools": []
      }
    },
    "slack-kilic": {
      "args": ["-y", "--bun", "@modelcontextprotocol/server-slack@latest"],
      "command": "bunx",
      "env": {
        "SLACK_BOT_TOKEN": "${NVIM_SLACK_TOKEN}",
        "SLACK_TEAM_ID": "${NVIM_SLACK_TEAM_ID}"
      },
      "hyprpilot": {
        "autoAcceptTools": ["slack_list_channels", "slack_get_channel_history", "slack_get_thread_replies", "slack_get_users", "slack_get_user_profile", "slack_add_reaction"],
        "autoRejectTools": []
      }
    },
    "sourcebot-kilic": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}",
        "x-sourcebot-api-key": "${NVIM_SOURCEBOT_API_KEY}"
      },
      "url": "https://sourcebot.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": ["find_symbol_definitions", "find_symbol_references", "get_diff", "glob", "grep", "list_commits", "list_repos", "list_tree", "read_file"],
        "autoRejectTools": []
      }
    },
    "vault-kilic": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}",
        "x-vault-token": "${NVIM_VAULT_TOKEN}"
      },
      "url": "https://vault.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": ["list_mounts", "list_secrets", "list_pki_issuers"],
        "autoRejectTools": []
      }
    },
    "cloudflare-kilic": {
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
