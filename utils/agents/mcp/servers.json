{
  "mcpServers": {
    "excalidraw": {
      "url": "https://mcp.excalidraw.com",
      "hyprpilot": {
        "autoAcceptTools": ["read_me", "create_view", "export_to_excalidraw", "save_checkpoint", "read_checkpoint"],
        "autoRejectTools": []
      }
    },
    "github": {
      "headers": {
        "Authorization": "Bearer ${NVIM_GITHUB}",
        "X-MCP-Insiders": "true"
      },
      "url": "https://api.githubcopilot.com/mcp/",
      "hyprpilot": {
        "excludeTools": [
          "assign_copilot_to_issue",
          "create_branch",
          "create_or_update_file",
          "create_repository",
          "delete_file",
          "fork_repository",
          "get_label",
          "get_team_members",
          "merge_pull_request"
        ],
        "autoAcceptTools": [
          "get_me",
          "issue_read",
          "list_pull_requests",
          "list_issues",
          "list_issue_types",
          "list_releases",
          "list_tags",
          "search_code",
          "search_issues",
          "search_pull_requests",
          "search_repositories",
          "search_users",
          "list_commits",
          "list_branches",
          "get_teams",
          "get_team_members",
          "get_tag",
          "get_release_by_tag",
          "get_latest_release",
          "get_label",
          "get_file_contents",
          "get_commit",
          "pull_request_read",
          "request_copilot_review"
        ],
        "autoRejectTools": []
      }
    },
    "obsidian": {
      "url": "http://127.0.0.1:27123/mcp/",
      "headers": {
        "Authorization": "Bearer ${NVIM_OBSIDIAN}"
      },
      "hyprpilot": {
        "autoAcceptTools": [
          "active_file_get_path",
          "command_list",
          "open_file",
          "search_query",
          "search_simple",
          "tag_list",
          "vault_get_document_map",
          "vault_list",
          "vault_read"
        ],
        "autoRejectTools": []
      }
    },
    "research": {
      "headers": {
        "Authorization": "Bearer ${AI_KILIC_DEV_API_KEY}"
      },
      "url": "https://research.mcp.kilic.dev/mcp",
      "hyprpilot": {
        "autoAcceptTools": [
          "exa_web_search_exa",
          "exa_web_fetch_exa",
          "tavily_tavily_search",
          "tavily_tavily_extract",
          "tavily_tavily_crawl",
          "tavily_tavily_map",
          "tavily_tavily_research",
          "context7_resolve-library-id",
          "context7_query-docs"
        ],
        "autoRejectTools": []
      }
    },
    "tmux": {
      "args": ["-y", "--bun", "tmux-mcp", "--shell-type=zsh"],
      "command": "bunx",
      "hyprpilot": {
        "excludeTools": ["create-session", "create-window", "execute-command", "kill-pane", "kill-session", "kill-window", "split-pane"],
        "autoAcceptTools": ["get-command-result", "list-panes", "list-sessions", "list-windows", "capture-pane", "find-session"],
        "autoRejectTools": []
      }
    }
  }
}
