{
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "autoApprove": [
        "get-library-docs",
        "resolve-library-id"
      ],
      "command": "bunx",
      "env": [],
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "autoApprove": [
        "fetch"
      ],
      "command": "uvx"
    },
    "github": {
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gitlab": {
      "args": [
        "mcp-server-gitlab"
      ],
      "command": "uvx",
      "disabled": true,
      "env": {
        "GITLAB_API_URL": "https://${GL_HOST}/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GL_TOKEN}"
      }
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "autoApprove": [
        "create_relations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "open_nodes",
        "read_graph",
        "search_nodes",
        "add_observations",
        "create_entities"
      ],
      "command": "bunx"
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "autoApprove": [
        "sequentialthinking"
      ],
      "command": "bunx"
    }
  },
  "nativeMCPServers": {
    "mcphub": {
      "autoApprove": [
        "get_current_servers"
      ]
    },
    "neovim": {
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "read_multiple_files"
      ],
      "disabled": false
    }
  }
}
