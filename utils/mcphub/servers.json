{
  "mcpServers": {
    "cclsp": {
      "args": [
        "-y",
        "cclsp"
      ],
      "autoApprove": [
        "find_definition",
        "find_references",
        "get_diagnostics"
      ],
      "command": "bunx",
      "disabled": false,
      "env": {
        "CCLSP_CONFIG_PATH": "${HOME}/.config/nvim/utils/claude/cclsp.json"
      }
    },
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "autoApprove": [
        "get-library-docs",
        "resolve-library-id"
      ],
      "command": "bunx",
      "env": [],
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "autoApprove": [
        "fetch"
      ],
      "command": "uvx"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "autoApprove": [
        "directory_tree",
        "get_file_info",
        "list_allowed_directories",
        "list_directory",
        "list_directory_with_sizes",
        "search_files"
      ],
      "command": "bunx"
    },
    "git": {
      "args": [
        "mcp-server-git"
      ],
      "autoApprove": [
        "git_diff",
        "git_diff_staged",
        "git_diff_unstaged",
        "git_log",
        "git_show",
        "git_status"
      ],
      "command": "uvx"
    },
    "github": {
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      },
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gitlab": {
      "args": [
        "mcp-server-gitlab"
      ],
      "command": "uvx",
      "disabled": true,
      "env": {
        "GITLAB_API_URL": "https://${GL_HOST}/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GL_TOKEN}"
      }
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "autoApprove": [
        "create_relations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "open_nodes",
        "read_graph",
        "search_nodes",
        "add_observations",
        "create_entities"
      ],
      "command": "bunx"
    },
    "nvim": {
      "args": [
        "-y",
        "mcp-neovim-server"
      ],
      "autoApprove": [
        "vim_buffer",
        "vim_buffer_switch",
        "vim_file_open",
        "vim_fold",
        "vim_grep",
        "vim_jump",
        "vim_search",
        "vim_status"
      ],
      "command": "bunx",
      "disabled": false,
      "env": {
        "ALLOW_SHELL_COMMANDS": "true",
        "NVIM_SOCKET_PATH": "${NVIM}"
      }
    },
    "sequentialthinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "autoApprove": [
        "sequentialthinking"
      ],
      "command": "bunx",
      "disabled": false
    },
    "treesitter": {
      "args": [
        "mcp-server-tree-sitter"
      ],
      "command": "uvx"
    },
    "vectorcode-mcp-server": {
      "args": [],
      "command": "vectorcode-mcp-server"
    }
  },
  "nativeMCPServers": {
    "mcphub": {
      "autoApprove": [
        "get_current_servers"
      ]
    },
    "neovim": {
      "autoApprove": [
        "find_files",
        "list_directory",
        "read_file",
        "read_multiple_files"
      ],
      "disabled": false
    }
  }
}
